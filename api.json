{
  "openapi": "3.0.0",
  "paths": {
    "/api": {
      "get": {
        "operationId": "AppController_getHello",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "App"
        ]
      }
    },
    "/api/prayer/meta": {
      "get": {
        "operationId": "PrayerController_getPrayerMeta",
        "parameters": [
          {
            "name": "prayerCode",
            "required": false,
            "in": "query",
            "description": "Код намаза. Если не передан ни один параметр, возвращается глобальная версия контента.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "madhhabCode",
            "required": false,
            "in": "query",
            "description": "Опциональный фильтр по мазхабу для точного prayer scope",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genderCode",
            "required": false,
            "in": "query",
            "description": "Опциональный фильтр по полу для точного prayer scope",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languageCode",
            "required": false,
            "in": "query",
            "description": "Опциональный фильтр по языку для точного prayer scope",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rakah",
            "required": false,
            "in": "query",
            "description": "Опциональный фильтр по номеру ракаата",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "script",
            "required": false,
            "in": "query",
            "description": "Опциональный фильтр по скрипту транслитерации",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Метаданные контента намаза успешно получены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPrayerMetaResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры запроса"
          },
          "404": {
            "description": "Сущность для заданного контекста не найдена"
          }
        },
        "summary": "Получение метаданных версии контента намаза для глобальной или контекстной синхронизации",
        "tags": [
          "Prayer"
        ]
      }
    },
    "/api/prayer": {
      "get": {
        "operationId": "PrayerController_getPrayer",
        "parameters": [
          {
            "name": "prayerCode",
            "required": true,
            "in": "query",
            "description": "Код намаза (fajr, dhuhr, asr)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "madhhabCode",
            "required": true,
            "in": "query",
            "description": "Код мазхаба (hanafi, shafii)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genderCode",
            "required": true,
            "in": "query",
            "description": "Код пола (male, female)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languageCode",
            "required": true,
            "in": "query",
            "description": "Код языка (ru, en)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rakah",
            "required": true,
            "in": "query",
            "description": "Номер ракаата (начиная с 1)",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "script",
            "required": false,
            "in": "query",
            "description": "Скрипт транслитерации (latin, cyrillic)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Структура намаза успешно получена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPrayerResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры запроса"
          },
          "404": {
            "description": "Данные не найдены по переданному контексту"
          }
        },
        "summary": "Получение структуры намаза по мазхабу, полу, языку и ракаату",
        "tags": [
          "Prayer"
        ]
      }
    },
    "/api/admin/steps": {
      "post": {
        "operationId": "StepController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStepDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Step created"
          },
          "409": {
            "description": "Step code already exists"
          }
        },
        "summary": "Create step",
        "tags": [
          "Step"
        ]
      },
      "get": {
        "operationId": "StepController_findAll",
        "parameters": [],
