    "/api/surah": {
      "get": {
        "operationId": "SurahController_getSurah",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "description": "Код суры (например, al_ikhlas)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "required": true,
            "in": "query",
            "description": "Код языка перевода и транслитерации (например, ru, en)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Сура успешно получена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSurahResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры запроса"
          },
          "404": {
            "description": "Сура не найдена"
          }
        },
        "summary": "Получение суры с арабским текстом, переводом и транслитерацией",
        "tags": [
          "Surah"
        ]
      }
    }
  },
  "info": {
    "title": "API Documentation",
    "description": "Project API docs",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "PrayerMetaDto": {
        "type": "object",
        "properties": {
          "lastModifiedAt": {
            "type": "string",
            "description": "Последнее изменение контента, влияющего на отображение намаза",
            "example": "2026-03-12T10:00:00.000Z",
            "nullable": true
          },
          "scope": {
            "type": "string",
            "description": "Область вычисления метаданных",
            "example": "global"
          }
        },
        "required": [
          "lastModifiedAt"
        ]
      },
      "GetPrayerMetaResponseDto": {
        "type": "object",
        "properties": {
          "meta": {
            "description": "Метаданные версии контента намаза",
            "allOf": [
              {
                "$ref": "#/components/schemas/PrayerMetaDto"
              }
            ]
          }
        },
        "required": [
          "meta"
        ]
      },
      "PrayerContextDto": {
        "type": "object",
        "properties": {
          "prayerCode": {
            "type": "string",
            "description": "Код намаза",
            "example": "fajr"
          },
          "madhhabCode": {
            "type": "string",
            "description": "Код мазхаба",
            "example": "hanafi"
          },
          "genderCode": {
            "type": "string",
            "description": "Код пола",
            "example": "male"
          },
          "languageCode": {
            "type": "string",
            "description": "Код языка",
            "example": "ru"
          },
          "rakah": {
            "type": "number",
            "description": "Номер ракаата",
            "example": 1
          },
          "script": {
            "type": "string",
            "description": "Выбранный скрипт для транслитерации",
            "nullable": true,
            "example": "cyrillic"
          },
          "totalRakahCount": {
            "type": "number",
            "description": "Общее количество ракаатов в выбранном намазе",
            "example": 2
          }
        },
        "required": [
          "prayerCode",
          "madhhabCode",
          "genderCode",
          "languageCode",
          "rakah",
          "script",
          "totalRakahCount"
        ]
      },
      "PrayerStepContentDto": {
        "type": "object",
        "properties": {
          "movementDescription": {
            "type": "string",
            "description": "Описание движения (на выбранном языке)",
            "nullable": true,
            "example": "Поднимите руки до уровня плеч"
          },
          "recitationArabic": {
            "type": "string",
            "description": "Текст чтения на арабском языке",
            "nullable": true,
            "example": "الله أكبر"
          },
          "translation": {
            "type": "string",
            "description": "Перевод текста на выбранный язык",
            "nullable": true,
            "example": "Аллах Велик"
          },
          "transliteration": {
            "type": "string",
            "description": "Транслитерация (с учетом выбранного скрипта)",
            "nullable": true,
            "example": "Allahu Akbar"
          }
        },
        "required": [
          "movementDescription",
          "recitationArabic",
          "translation",
          "transliteration"
        ]
      },
      "PrayerStepDto": {
        "type": "object",
        "properties": {
          "orderIndex": {
            "type": "number",
            "description": "Порядковый номер шага внутри ракаата",
            "example": 1
          },
          "stepCode": {
            "type": "string",
            "description": "Код шага намаза",
            "example": "takbir"
          },
          "recitationMode": {
            "type": "string",
            "description": "Режим чтения для шага",
            "example": "silent"
          },
          "hasRecitation": {
            "type": "boolean",
            "description": "Признак наличия чтения в данном шаге",
            "example": true
          },
          "content": {
            "description": "Контент шага (описание, арабский текст, перевод, транслитерация)",
            "allOf": [
              {
                "$ref": "#/components/schemas/PrayerStepContentDto"
              }
            ]
          }
        },
        "required": [
          "orderIndex",
          "stepCode",
          "recitationMode",
          "hasRecitation",
          "content"
        ]
      },
      "PrayerDataDto": {
        "type": "object",
        "properties": {
          "context": {
            "description": "Контекст запроса, по которому была собрана структура намаза",
            "allOf": [
              {
                "$ref": "#/components/schemas/PrayerContextDto"
              }
            ]
          },
          "steps": {
            "description": "Список шагов намаза для указанного ракаата",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrayerStepDto"
            }
          }
        },
        "required": [
          "context",
          "steps"
        ]
      },
      "GetPrayerResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "description": "Данные намаза для указанного контекста",
            "allOf": [
              {
                "$ref": "#/components/schemas/PrayerDataDto"
              }
            ]
          },
          "meta": {
            "description": "Метаданные версии контента для текущего ответа",
            "allOf": [
              {
                "$ref": "#/components/schemas/PrayerMetaDto"
              }
            ]
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CreateStepDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateStepDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePrayerStepDto": {
        "type": "object",
        "properties": {}
      },
      "UpdatePrayerStepDto": {
        "type": "object",
        "properties": {}
      },
      "CreateStepContentDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateStepContentDto": {
        "type": "object",
        "properties": {}
      },
      "GetSurahResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Код суры",
            "example": "al_ikhlas"
          },
          "recitationArabic": {
            "type": "string",
            "description": "Текст чтения на арабском языке",
            "nullable": true,
            "example": "قُلْ هُوَ اللَّهُ أَحَدٌ"
          },
          "translation": {
            "type": "string",
            "description": "Перевод на выбранный язык",
            "nullable": true,
            "example": "Скажи: Он - Аллах Единый"
          },
          "transliteration": {
            "type": "string",
            "description": "Транслитерация на выбранном языке",
            "nullable": true,
            "example": "Qul huwallahu ahad"
          }
        },
        "required": [
          "code",
          "recitationArabic",
          "translation",
          "transliteration"
        ]
      }
    }
  }
}